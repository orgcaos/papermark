VERSION 1

NODE endpoint
SQL >
    %
    SELECT
        viewId,
        pageNumber,
        SUM(duration) AS sum_duration
    FROM
        page_views
    WHERE
        viewId IN splitByChar(',', {{ String(viewIds, required=true) }})
        AND time >= {{ Int64(since, required=true) }}
    GROUP BY
        viewId, pageNumber
    ORDER BY
        viewId, pageNumber ASC

TYPE ENDPOINT
